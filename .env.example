# Copy this file to `.env`, then fill in the values.

# Name shown in the app bar.
BOT_NAME=AI Assistant

# Copilot Studio → Channels → Mobile app → Token Endpoint.
# The app asks this URL for a short-lived token, so no secret is stored in the app.
DIRECT_LINE_TOKEN_ENDPOINT=https://<your-environment>.environment.api.powerplatform.com/powervirtualagents/botsbyschema/<your-agent>/directline/token?api-version=2022-03-01-preview

# Direct Line API. Keep the default unless your agent uses a regional endpoint.
DIRECT_LINE_BASE_URL=https://directline.botframework.com/v3/directline

# Only if your agent has no token endpoint (web channel security turned on).
# Not recommended: everything in this file is packaged inside the app and can
# be read by anyone who has the app. Real apps keep the secret on a server.
# DIRECT_LINE_SECRET=
